#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "ur5e"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "ur5e"
{
    over "Geometry"
    {
        over "world"
        {
            over "base_link"
            {
                over "base_link_inertia" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                )
                {
                    double[] newton:inertia = [0.00443333156, 0.00443333156, 0.0072, 0, 0, 0]
                    bool newton:selfCollisionEnabled = 0
                    point3f physics:centerOfMass = (0, 0, 0)
                    float3 physics:diagonalInertia = (0.0044333315, 0.0044333315, 0.0072)
                    float physics:mass = 4
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "shoulder_link" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                    )
                    {
                        double[] newton:inertia = [0.0070021, 0.00657286, 0.00648091, 0.00001053, 7.300000000000047e-7, -0.00049994]
                        point3f physics:centerOfMass = (0, -0.00193, -0.02561)
                        float3 physics:diagonalInertia = (0.006024776, 0.0070003048, 0.0070307893)
                        float physics:mass = 3.761
                        quatf physics:principalAxes = (-0.20206705, 0.67473114, 0.60877776, 0.36509764)

                        over "upper_arm_link" (
                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                        )
                        {
                            double[] newton:inertia = [0.01505885, 0.33388086, 0.33247207, -0.000054, 0.00000563, -0.00000181]
                            point3f physics:centerOfMass = (-0.2125, 0, 0.11336)
                            float3 physics:diagonalInertia = (0.015058841, 0.33247206, 0.33388087)
                            float physics:mass = 8.058
                            quatf physics:principalAxes = (0.70756114, 0.70665216, 0.000066118744, 0.000053654363)

                            over "forearm_link" (
                                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                            )
                            {
                                double[] newton:inertia = [0.00399632, 0.07879254, 0.0784851, -0.00001365, 0.00137272, -0.0000066]
                                point3f physics:centerOfMass = (-0.2422, 0, 0.0265)
                                float3 physics:diagonalInertia = (0.003971029, 0.078510225, 0.078792706)
                                float physics:mass = 2.846
                                quatf physics:principalAxes = (0.71560067, 0.6984489, 0.006654075, -0.0063682753)

                                over "wrist_1_link" (
                                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                                )
                                {
                                    double[] newton:inertia = [0.00165491, 0.00126279, 0.00135962, 0.000004380000000000001, -0.000002819999999999998, -0.00010157000000000006]
                                    point3f physics:centerOfMass = (0, -0.01634, -0.0018)
                                    float3 physics:diagonalInertia = (0.0011986756, 0.0014236274, 0.001655017)
                                    float physics:mass = 1.37
                                    quatf physics:principalAxes = (0.34859392, 0.61716497, -0.33430785, -0.6211505)

                                    over "wrist_2_link" (
                                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                                    )
                                    {
                                        double[] newton:inertia = [0.00135617, 0.00096614, 0.00127827, 0.000004440000000000001, 0.000002739999999999998, 0.00005048000000000014]
                                        point3f physics:centerOfMass = (0, 0.01634, -0.0018)
                                        float3 physics:diagonalInertia = (0.00095813966, 0.0012860664, 0.001356374)
                                        float physics:mass = 1.3
                                        quatf physics:principalAxes = (-0.4440672, 0.5457389, 0.47465158, -0.5288471)

                                        over "wrist_3_link" (
                                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                                        )
                                        {
                                            double[] newton:inertia = [0.00018694, 0.00018908, 0.00025756, 6e-8, -1.7e-7, -9.2e-7]
                                            point3f physics:centerOfMass = (0, 0, -0.001159)
                                            float3 physics:diagonalInertia = (0.00018693802, 0.00018906921, 0.00025757277)
                                            float physics:mass = 0.365
                                            quatf physics:principalAxes = (0.99988484, 0.0067323972, -0.0011178805, -0.013553714)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        def PhysicsRevoluteJoint "shoulder_pan_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 1.7453293
            float drive:angular:physics:maxForce = 150
            float drive:angular:physics:stiffness = 17.453293
            uniform token drive:angular:physics:type = "force"
            float newton:velocityLimit = 180
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </ur5e/Geometry/world/base_link/base_link_inertia>
            custom rel physics:body1
            append rel physics:body1 = </ur5e/Geometry/world/base_link/base_link_inertia/shoulder_link>
            point3f physics:localPos0 = (0, 0, 0.1625)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -360
            float physics:upperLimit = 360
            custom float urdf:limit:effort = 150
        }

        def PhysicsRevoluteJoint "shoulder_lift_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 1.7453293
