        def PhysicsFixedJoint "tn__base_linkbase_link_inertia_kc0"
        {
            custom rel physics:body0
            append rel physics:body0 = </ur5e/Geometry/world/base_link>
            custom rel physics:body1
            append rel physics:body1 = </ur5e/Geometry/world/base_link/base_link_inertia>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
